<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="init_stake">Initial Stake</variable>
    <variable id="current_stake">Stake</variable>
    <variable id="tp">Take Profit</variable>
    <variable id="sl">Stop Loss</variable>
    <variable id="pred">Prediction</variable>
    <variable id="trade_type">Contract Type</variable>
    <variable id="mult">Recovery Multiplier</variable>
  </variables>
  <!-- BLOCK 1: TRADE DEFINITION -->
  <block type="trade_definition" id="trade_def_root" deletable="false" x="0" y="0">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="market_def" deletable="false" movable="false">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">1HZ10V</field>
        <next>
          <block type="trade_definition_tradetype" id="tradetype_def" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST">digits</field>
            <field name="TRADETYPE_LIST">overunder</field>
            <next>
              <block type="trade_definition_contracttype" id="contracttype_def" deletable="false" movable="false">
                <field name="TYPE_LIST">both</field>
                <next>
                  <block type="trade_definition_candleinterval" id="candle_def" deletable="false" movable="false">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="restart_def" deletable="false" movable="false">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="restart_err_def" deletable="false" movable="false">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="variables_set" id="set_init_stake">
        <field name="VAR" id="init_stake">Initial Stake</field>
        <value name="VALUE">
          <block type="math_number" id="num_init_stake">
            <field name="NUM">0.35</field>
          </block>
        </value>
        <next>
          <block type="variables_set" id="set_stake">
            <field name="VAR" id="current_stake">Stake</field>
            <value name="VALUE">
              <block type="math_number" id="num_stake">
                <field name="NUM">0.35</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="set_tp">
                <field name="VAR" id="tp">Take Profit</field>
                <value name="VALUE">
                  <block type="math_number" id="num_tp">
                    <field name="NUM">10</field>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="set_sl">
                    <field name="VAR" id="sl">Stop Loss</field>
                    <value name="VALUE">
                      <block type="math_number" id="num_sl">
                        <field name="NUM">50</field>
                      </block>
                    </value>
                    <next>
                      <block type="variables_set" id="set_mult">
                        <field name="VAR" id="mult">Recovery Multiplier</field>
                        <value name="VALUE">
                          <block type="math_number" id="num_mult">
                            <field name="NUM">3.4</field>
                          </block>
                        </value>
                        <next>
                          <block type="variables_set" id="set_pred">
                            <field name="VAR" id="pred">Prediction</field>
                            <value name="VALUE">
                              <block type="math_number" id="num_pred">
                                <field name="NUM">7</field>
                              </block>
                            </value>
                            <next>
                              <block type="variables_set" id="set_type">
                                <field name="VAR" id="trade_type">Contract Type</field>
                                <value name="VALUE">
                                  <block type="text" id="text_type">
                                    <field name="TEXT">DIGITUNDER</field>
                                  </block>
                                </value>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="trade_options" deletable="false" movable="false">
        <mutation xmlns="http://www.w3.org/1999/xhtml" has_prediction="true"></mutation>
        <field name="DURATIONTYPE_LIST">t</field>
        <field name="CURRENCY_LIST">USD</field>
        <value name="DURATION">
          <shadow type="math_number" id="dur_val">
            <field name="NUM">1</field>
          </shadow>
        </value>
        <value name="AMOUNT">
          <block type="variables_get" id="get_stake">
            <field name="VAR" id="current_stake">Stake</field>
          </block>
        </value>
        <value name="PREDICTION">
          <block type="variables_get" id="get_pred">
            <field name="VAR" id="pred">Prediction</field>
          </block>
        </value>
      </block>
    </statement>
  </block>
  <!-- BLOCK 2: BEFORE PURCHASE -->
  <block type="before_purchase" id="before_purchase_root" deletable="false" x="0" y="700">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="controls_if" id="check_trade_type">
        <mutation else="1"></mutation>
        <value name="IF0">
          <block type="logic_compare" id="compare_under">
            <field name="OP">EQ</field>
            <value name="A">
              <block type="variables_get" id="get_tt_1">
                <field name="VAR" id="trade_type">Contract Type</field>
              </block>
            </value>
            <value name="B">
              <block type="text" id="text_cmp_under">
                <field name="TEXT">DIGITUNDER</field>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <block type="purchase" id="buy_under">
            <field name="PURCHASE_LIST">DIGITUNDER</field>
          </block>
        </statement>
        <statement name="ELSE">
          <block type="purchase" id="buy_over">
            <field name="PURCHASE_LIST">DIGITOVER</field>
          </block>
        </statement>
      </block>
    </statement>
  </block>
  <!-- BLOCK 3: AFTER PURCHASE (MAGIC RECOVERY & RISK MANAGEMENT) -->
  <block type="after_purchase" id="after_purchase_root" deletable="false" x="0" y="980">
    <statement name="AFTERPURCHASE_STACK">
      <block type="controls_if" id="check_win_loss">
        <mutation else="1"></mutation>
        <value name="IF0">
          <block type="contract_check_result" id="is_win">
            <field name="CHECK_RESULT">win</field>
          </block>
        </value>
        <statement name="DO0">
          <!-- Reset to Base Under 7 on Win -->
          <block type="variables_set" id="reset_stake">
            <field name="VAR" id="current_stake">Stake</field>
            <value name="VALUE">
              <block type="variables_get" id="get_init_stake">
                <field name="VAR" id="init_stake">Initial Stake</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="reset_pred">
                <field name="VAR" id="pred">Prediction</field>
                <value name="VALUE">
                  <block type="math_number" id="num_pred_reset">
                    <field name="NUM">7</field>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="reset_type_under">
                    <field name="VAR" id="trade_type">Contract Type</field>
                    <value name="VALUE">
                      <block type="text" id="txt_under_reset">
                        <field name="TEXT">DIGITUNDER</field>
                      </block>
                    </value>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>
        <statement name="ELSE">
          <!-- Loss: Apply Recovery Stake Multiplier -->
          <block type="variables_set" id="apply_multiplier">
            <field name="VAR" id="current_stake">Stake</field>
            <value name="VALUE">
              <block type="math_arithmetic" id="mult_calc">
                <field name="OP">MULTIPLY</field>
                <value name="A">
                  <block type="variables_get" id="get_cur_stake">
                    <field name="VAR" id="current_stake">Stake</field>
                  </block>
                </value>
                <value name="B">
                  <block type="variables_get" id="get_mult_val">
                    <field name="VAR" id="mult">Recovery Multiplier</field>
                  </block>
                </value>
              </block>
            </value>
            <next>
              <!-- Switch Over/Under Strategy -->
              <block type="controls_if" id="toggle_recovery_direction">
                <mutation else="1"></mutation>
                <value name="IF0">
                  <block type="logic_compare" id="cmp_is_under">
                    <field name="OP">EQ</field>
                    <value name="A">
                      <block type="variables_get" id="get_tt_rec">
                        <field name="VAR" id="trade_type">Contract Type</field>
                      </block>
                    </value>
                    <value name="B">
                      <block type="text" id="txt_cmp_under_2">
                        <field name="TEXT">DIGITUNDER</field>
                      </block>
                    </value>
                  </block>
                </value>
                <statement name="DO0">
                  <!-- Under failed -> Switch to Over 2 -->
                  <block type="variables_set" id="switch_to_over">
                    <field name="VAR" id="trade_type">Contract Type</field>
                    <value name="VALUE">
                      <block type="text" id="txt_set_over">
                        <field name="TEXT">DIGITOVER</field>
                      </block>
                    </value>
                    <next>
                      <block type="variables_set" id="switch_pred_2">
                        <field name="VAR" id="pred">Prediction</field>
                        <value name="VALUE">
                          <block type="math_number" id="num_pred_2">
                            <field name="NUM">2</field>
                          </block>
                        </value>
                      </block>
                    </next>
                  </block>
                </statement>
                <statement name="ELSE">
                  <!-- Over failed -> Switch back to Under 7 -->
                  <block type="variables_set" id="switch_to_under">
                    <field name="VAR" id="trade_type">Contract Type</field>
                    <value name="VALUE">
                      <block type="text" id="txt_set_under">
                        <field name="TEXT">DIGITUNDER</field>
                      </block>
                    </value>
                    <next>
                      <block type="variables_set" id="switch_pred_7">
                        <field name="VAR" id="pred">Prediction</field>
                        <value name="VALUE">
                          <block type="math_number" id="num_pred_7">
                            <field name="NUM">7</field>
                          </block>
                        </value>
                      </block>
                    </next>
                  </block>
                </statement>
              </block>
            </next>
          </block>
        </statement>
        <next>
          <!-- Check TP & SL -->
          <block type="controls_if" id="check_tp_sl">
            <mutation else="1"></mutation>
            <value name="IF0">
              <block type="logic_operation" id="logic_stop_conditions">
                <field name="OP">OR</field>
                <value name="A">
                  <block type="logic_compare" id="cmp_tp">
                    <field name="OP">GTE</field>
                    <value name="A">
                      <block type="total_profit" id="tot_prof_a"></block>
                    </value>
                    <value name="B">
                      <block type="variables_get" id="get_tp_val">
                        <field name="VAR" id="tp">Take Profit</field>
                      </block>
                    </value>
                  </block>
                </value>
                <value name="B">
                  <block type="logic_compare" id="cmp_sl">
                    <field name="OP">LTE</field>
                    <value name="A">
                      <block type="total_profit" id="tot_prof_b"></block>
                    </value>
                    <value name="B">
                      <block type="math_single" id="neg_sl">
                        <field name="OP">NEG</field>
                        <value name="NUM">
                          <block type="variables_get" id="get_sl_val">
                            <field name="VAR" id="sl">Stop Loss</field>
                          </block>
                        </value>
                      </block>
                    </value>
                  </block>
                </value>
              </block>
            </value>
            <statement name="DO0">
              <block type="text_print" id="print_stop">
                <value name="TEXT">
                  <shadow type="text" id="txt_stopped">
                    <field name="TEXT">Target reached (TP or SL). Bot stopped!</field>
                  </shadow>
                </value>
              </block>
            </statement>
            <statement name="ELSE">
              <block type="trade_again" id="do_trade_again"></block>
            </statement>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>
